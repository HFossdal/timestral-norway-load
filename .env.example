# Copy this file to .env and fill in your own values. .env is gitignored.

# MET Norway Frost API (https://frost.met.no/auth/requestCredentials.html)
# Only the client ID is needed for observations; the secret is not used.
FROST_CLIENT_ID=

# ENTSO-E Transparency Platform security token (only for the Statnett day-ahead benchmark,
# src/data_entsoe.py; the load data comes from Elhub, which needs no key)
ENTSOE_API_TOKEN=
